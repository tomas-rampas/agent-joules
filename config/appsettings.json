{
  "AgentJoules": {
    "Gpu": {
      "Index": 0
    },
    "Meter": {
      "Method": "auto",
      "SampleRateHz": 10,
      "AllowBelowMinRate": false
    },
    "Baseline": {
      "Seconds": 30,
      "SettleSeconds": 0,
      "MaxCoefficientOfVariation": 0.10
    },
    "Tiers": {
      "local": {
        "BaseUrl": "http://localhost:8000/v1",
        "ModelId": "nvidia/Llama-3.1-Nemotron-Nano-4B-v1.1",
        "AgentModelIds": {},
        "Enabled": true,
        "ReasoningMode": "off",
        "SystemPromptPrefix": "detailed thinking off",
        "Precision": "BF16",
        "MaxTokensField": "max_tokens"
      },
      "cloudgpu": {
        "BaseUrl": "http://localhost:8000/v1",
        "ModelId": "nvidia/nemotron-3-nano",
        "AgentModelIds": {},
        "Enabled": false,
        "ReasoningMode": "off",
        "ExtraBodyJson": "{\"chat_template_kwargs\":{\"enable_thinking\":false}}",
        "Precision": "FP8"
      },
      "nvidia": {
        "BaseUrl": "https://integrate.api.nvidia.com/v1",
        "ModelId": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "AgentModelIds": {},
        "ApiKeyVariable": "NVIDIA_API_KEY",
        "Enabled": true,
        "ReasoningMode": "off",
        "ExtraBodyJson": "{\"chat_template_kwargs\":{\"enable_thinking\":false}}",
        "MissingPriceReason": "free-tier-no-price"
      },
      "nebius": {
        "BaseUrl": "https://api.tokenfactory.nebius.com/v1",
        "ModelId": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
        "AgentModelIds": {},
        "ApiKeyVariable": "NEBIUS_API_KEY",
        "Enabled": true,
        "ReasoningMode": "off",
        "ExtraBodyJson": "{\"chat_template_kwargs\":{\"enable_thinking\":false}}"
      }
    },
    "Judge": {
      "Tier": "nvidia",
      "ModelId": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
      "MaxOutputTokens": 32
    },
    "Local": {
      "Runtime": "nim"
    },
    "Workflow": {
      "Seed": 42
    },
    "CloudGpu": {
      "Provider": "nebius-ai-cloud",
      "RequireSshVariables": true,
      "CostStopUsd": 25,
      "TimeBoxHours": 4
    },
    "Cost": {
      "ElectricityPricePerKwh": 0.30,
      "Currency": "EUR"
    },
    "Report": {
      "RepositoryUrl": "https://github.com/tomas-rampas/agent-joules"
    },
    "Dashboard": {
      "PowerIntervalMs": 100
    }
  }
}
