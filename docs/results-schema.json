        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "measured"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "unit"
                ]
              },
              {
                "required": [
                  "currency"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "estimated"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "unit"
                ]
              },
              {
                "required": [
                  "currency"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "model-judged"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "not": {
              "required": [
                "unit",
                "currency"
              ]
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "local",
            "cloudgpu",
            "nvidia",
            "nebius"
          ]
        },
        "startUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endUtc": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "cancelled",
            "error",
            "incomplete"
          ]
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "$ref": "#/$defs/metricMeasured"
        },
        "ttftMs": {
          "$ref": "#/$defs/metricMeasured"
        },
        "inputTokens": {
          "$ref": "#/$defs/metricMeasured"
        },
        "outputTokens": {
          "$ref": "#/$defs/metricMeasured"
        },
        "grossJoules": {
          "$ref": "#/$defs/metricMeasured"
        },
        "netJoules": {
          "$ref": "#/$defs/metricMeasured"
        },
        "avgW": {
          "$ref": "#/$defs/metricMeasured"
        },
        "peakW": {
          "$ref": "#/$defs/metricMeasured"
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "counter",
            "sampling",
            null
          ],
          "default": null
        },
        "sampleCount": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0
        },
        "sampleRateHz": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "exclusiveMinimum": 0
        },
        "cost": {
          "allOf": [
            {
              "$ref": "#/$defs/metricEstimated"
            },
            {
              "if": {
                "properties": {
                  "label": {
                    "const": "estimated"
                  }
                },
                "required": [
                  "label"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "minimum": 0
                  }
                },
                "required": [
                  "currency"
                ],
                "not": {
                  "required": [
                    "unit"
                  ]
                }
              }
            }
          ]
        },
        "quality": {
          "allOf": [
            {
              "$ref": "#/$defs/metricJudged"
            },
            {
              "if": {
                "properties": {
                  "label": {
                    "const": "model-judged"
                  }
                },
                "required": [
                  "label"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "unit"
                      ]
                    },
                    {
                      "required": [
                        "currency"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "qualityReason": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "joulesPerQualityPoint": {
          "allOf": [
            {
              "$ref": "#/$defs/metricJudged"
            },
            {
              "if": {
                "properties": {
                  "label": {
                    "const": "model-judged"
                  }
                },
                "required": [
                  "label"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "minimum": 0
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "unit"
                      ]
                    },
                    {
                      "required": [
                        "currency"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "costPerQualityPoint": {
          "allOf": [
