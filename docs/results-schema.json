{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentjoules:results-schema:1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "local",
            "cloudgpu",
            "nvidia",
            "nebius"
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "serialized",
            "concurrent"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "startUtc": {
          "type": "string",
          "format": "date-time"
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1
        },
        "gitCommit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "partial",
            "incomplete"
          ]
        },
        "flags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "partial-offload",
              "non-publishable"
            ]
          },
          "default": null,
          "uniqueItems": true
        },
        "stopReason": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "selfJudged": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "tier",
        "tasks",
        "mode",
        "repeat",
        "startUtc",
        "toolVersion",
        "gitCommit",
        "status"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "gpuName": {
          "type": [
            "string",
            "null"
          ]
        },
        "driverVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": "string"
        },
        "dotnetVersion": {
          "type": "string"
        },
        "localRuntime": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtimeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpuOffloadPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "modelLoadSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "powerSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoningMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "instancePreset": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpuUuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "containerImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "containerDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cloudCostUsd": {
          "$ref": "#/$defs/metricMeasured"
        },
        "energyScope": {
          "type": "string",
          "const": "GPU-board only"
        },
        "assumptions": {
          "type": "object",
          "properties": {
            "electricityPrice": {
              "$ref": "#/$defs/metricEstimated"
            },
            "gco2ePerKwh": {
              "$ref": "#/$defs/metricEstimated"
            }
          },
          "required": [
            "electricityPrice",
            "gco2ePerKwh"
          ],
          "additionalProperties": false
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "modelId": {
                "type": "string"
              },
              "baseline": {
                "type": "boolean"
              }
            },
            "required": [
              "agent",
              "modelId",
              "baseline"
            ],
            "additionalProperties": false
          }
        },
        "cloudCostObservedUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null
        }
      },
      "required": [
        "gpuName",
        "driverVersion",
        "os",
        "dotnetVersion",
        "localRuntime",
        "runtimeVersion",
        "gpuOffloadPercent",
        "modelLoadSeconds",
        "powerSource",
        "reasoningMode",
        "temperature",
        "provider",
        "instancePreset",
        "region",
        "gpuUuid",
        "containerImage",
        "containerDigest",
        "precision",
        "cloudCostUsd",
        "energyScope",
        "assumptions",
        "models"
      ],
      "additionalProperties": false
    },
    "probe": {
      "anyOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "meanW": {
          "$ref": "#/$defs/metricMeasured"
        },
        "stdDevW": {
          "$ref": "#/$defs/metricMeasured"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "coefficientOfVariation": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxCoefficientOfVariation": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sampling-fallback",
              "low-resolution",
              "shared-window",
              "baseline-unstable",
              "below-baseline",
              "throttled",
              "partial-offload",
              "max-tokens-exceeded",
              "duplicate-output"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "meanW",
        "stdDevW",
        "seconds",
        "sampleCount",
        "coefficientOfVariation",
        "maxCoefficientOfVariation",
        "flags"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/step"
          },
          {
            "not": {
              "required": [
                "judgedAgent"
              ]
            }
          }
        ]
      }
    },
    "judge": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/step"
          },
          {
            "required": [
              "judgedAgent"
            ]
          }
        ]
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "grossJoules": {
          "$ref": "#/$defs/metricMeasured"
        },
        "netJoules": {
          "$ref": "#/$defs/metricMeasured"
        },
        "inputTokens": {
          "$ref": "#/$defs/metricMeasured"
        },
        "outputTokens": {
          "$ref": "#/$defs/metricMeasured"
        },
        "costByCurrency": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/metricEstimated"
              },
              {
                "properties": {
                  "label": {
                    "enum": [
                      "estimated",
                      "N/A"
                    ]
                  }
                },
                "if": {
                  "properties": {
                    "label": {
                      "const": "estimated"
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "minimum": 0
                    }
                  },
                  "required": [
                    "currency"
                  ],
                  "not": {
                    "required": [
                      "unit"
                    ]
                  }
                }
              }
            ]
          }
        },
        "wallClockMs": {
          "$ref": "#/$defs/metricMeasured"
        },
        "judge": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "$ref": "#/$defs/metricMeasured"
            },
            "outputTokens": {
              "$ref": "#/$defs/metricMeasured"
            },
            "costByCurrency": {
              "type": "object",
              "additionalProperties": {
                "allOf": [
                  {
                    "$ref": "#/$defs/metricEstimated"
                  },
                  {
                    "properties": {
                      "label": {
                        "enum": [
                          "estimated",
                          "N/A"
                        ]
                      }
                    },
                    "if": {
                      "properties": {
                        "label": {
                          "const": "estimated"
                        }
                      },
                      "required": [
                        "label"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "minimum": 0
                        }
                      },
                      "required": [
                        "currency"
                      ],
                      "not": {
                        "required": [
                          "unit"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "costByCurrency"
          ],
          "additionalProperties": false
        },
        "gco2e": {
          "$ref": "#/$defs/metricEstimated"
        }
      },
      "required": [
        "grossJoules",
        "netJoules",
        "inputTokens",
        "outputTokens",
        "costByCurrency",
        "wallClockMs",
        "judge",
        "gco2e"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "run",
    "environment",
    "probe",
    "baseline",
    "steps",
    "judge",
    "totals"
  ],
  "additionalProperties": false,
  "$defs": {
    "metricMeasured": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "enum": [
            "measured",
            "N/A",
            "not-reported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "N/A",
                  "not-reported"
                ]
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit"
                  ]
                },
                {
                  "required": [
                    "currency"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "measured"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "unit"
                ]
              },
              {
                "required": [
                  "currency"
                ]
              }
            ]
          }
        }
      ]
    },
    "metricEstimated": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "enum": [
            "estimated",
            "N/A",
            "not-reported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "N/A",
                  "not-reported"
                ]
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit"
                  ]
                },
                {
                  "required": [
                    "currency"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "estimated"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "unit"
                ]
              },
              {
                "required": [
                  "currency"
                ]
              }
            ]
          }
        }
      ]
    },
    "metricJudged": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "enum": [
            "model-judged",
            "N/A",
            "not-reported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "N/A",
                  "not-reported"
                ]
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit"
                  ]
                },
                {
                  "required": [
                    "currency"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "model-judged"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "not": {
              "required": [
                "unit",
                "currency"
              ]
            }
          }
        }
      ]
    },
    "metricAny": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "enum": [
            "measured",
            "estimated",
            "model-judged",
            "N/A",
            "not-reported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
